import pandas as pd
import os

# -----------------------------
# 1. SET WORKING DIRECTORY
# -----------------------------
os.chdir(r"C:\Users\shruc\OneDrive\Desktop\Project\Dataset")

print("Files in folder:", os.listdir())

# -----------------------------
# 2. LOAD DATA
# -----------------------------
sales = pd.read_csv("new sales data.csv")
users = pd.read_csv("users.csv")
kpi = pd.read_csv("KPI_table.csv")

# =============================
# 🧾 3. CLEAN SALES DATA
# =============================
print("\nCleaning Sales Data...")

# Remove duplicates
sales.drop_duplicates(inplace=True)

# -----------------------------
# STANDARDIZE TEXT
# -----------------------------
sales['product_name'] = sales['product_name'].astype(str).str.strip().str.title()
sales['region'] = sales['region'].astype(str).str.strip().str.title()

# -----------------------------
# HANDLE MISSING REGION (SMART FIX)
# -----------------------------
# Replace empty/Unknown with NaN
sales['region'] = sales['region'].replace(['Unknown', '', 'Nan'], pd.NA)

# Fill region using most frequent region per product
sales['region'] = sales.groupby('product_name')['region'] \
    .transform(lambda x: x.fillna(x.mode()[0] if not x.mode().empty else 'Other'))

# Final fallback
sales['region'] = sales['region'].fillna('Other')

# -----------------------------
# 🔥 FIX CATEGORY (NO "OTHERS")
# -----------------------------
# Define proper category mapping
product_category_map = {
    # Electronics
    "Laptop": "Electronics",
    "Mobile": "Electronics",
    "Tablet": "Electronics",
    "Headphones": "Electronics",
    "Tv": "Electronics",

    # Accessories
    "Mouse": "Accessories",
    "Keyboard": "Accessories",
    "Charger": "Accessories",

    # Clothing
    "Shirt": "Clothing",
    "T-Shirt": "Clothing",
    "Jeans": "Clothing",
    "Jacket": "Clothing",

    # Footwear
    "Shoes": "Footwear",
    "Sneakers": "Footwear",
    "Sandals": "Footwear"
}

# Apply mapping
sales['category'] = sales['product_name'].map(product_category_map)

# Handle products not in mapping
sales['category'] = sales['category'].fillna('Misc')

# -----------------------------
# HANDLE OTHER MISSING VALUES
# -----------------------------
sales.fillna({
    'product_name': 'Unknown'
}, inplace=True)

# Fill numeric columns
for col in sales.select_dtypes(include=['int64', 'float64']).columns:
    sales[col] = sales[col].fillna(0)

# =============================
# 👤 4. CLEAN USERS DATA
# =============================
print("Cleaning Users Data...")

users.drop_duplicates(inplace=True)

users.fillna({
    'name': 'Unknown',
    'email': 'Not Provided',
    'password': 'NoPassword'
}, inplace=True)

if 'user_id' in users.columns:
    users['user_id'] = users['user_id'].fillna(0).astype(int)

users['name'] = users['name'].astype(str).str.strip().str.title()
users['email'] = users['email'].astype(str).str.strip().str.lower()
users['password'] = users['password'].astype(str).str.replace(",", "").str.strip()

# =============================
# 📊 5. CLEAN KPI DATA
# =============================
print("Cleaning KPI Data...")

kpi.drop_duplicates(inplace=True)

kpi.fillna({
    'top_product': 'Unknown',
    'best_region': 'Unknown'
}, inplace=True)

kpi['month'] = kpi['month'].astype(str).str.strip().str.title()
kpi['top_product'] = kpi['top_product'].astype(str).str.strip().str.title()
kpi['best_region'] = kpi['best_region'].astype(str).str.strip().str.title()

# Fill remaining nulls
for col in kpi.columns:
    if kpi[col].dtype == 'object':
        kpi[col] = kpi[col].fillna("Unknown")
    else:
        kpi[col] = kpi[col].fillna(0)

# =============================
# 🔍 6. FINAL CHECK
# =============================
print("\nRegion Check:")
print(sales['region'].value_counts())

print("\nCategory Check:")
print(sales['category'].value_counts())

# =============================
# 💾 7. SAVE CLEANED FILES
# =============================
sales.to_csv("cleaned_sales_final.csv", index=False)
users.to_csv("cleaned_users_final.csv", index=False)
kpi.to_csv("cleaned_kpi_final.csv", index=False)

print("\n✅ DATA CLEANED SUCCESSFULLY (NO UNKNOWN REGION + PROPER CATEGORIES)")